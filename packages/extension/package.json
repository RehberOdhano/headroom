{
  "name": "@headroom/extension",
  "description": "Claude usage companion: limit bars, history, forecasting, and CLI attribution for claude.ai and Claude Code.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "@webext-core/messaging": "^4.0.0",
    "@headroom/shared": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "26.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.4"
  }
}
