{
  "name": "@headroom/daemon",
  "version": "0.1.2",
  "description": "Optional local daemon for Claude Usage Companion — unlocks CLI attribution, session search, retention warnings, and Guardrails.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RehberOdhano/headroom.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://github.com/RehberOdhano/headroom#readme",
  "bugs": "https://github.com/RehberOdhano/headroom/issues",
  "publishConfig": {
    "access": "public",
    "name": "@rehberodhano/claude-usage-companion-daemon"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "claude-usage-daemon": "./dist/cli.js",
    "claude-usage-statusline": "./bin/statusline.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "@hono/node-server": "^2.1.1",
    "ccusage": "20.0.20",
    "chokidar": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@headroom/shared": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "tsup": "^8.5.1"
  }
}
